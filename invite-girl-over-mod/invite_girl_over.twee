{
  (set:$stepdad_name to $stepdad's name)
  (set:$stop to (twirl:"alexia first","alexia second","stepdad first","stepdad second"))

  You go downstairs to wait. After a few minutes, the doorbell rings.

  ($play:"sound","doorbell")

  (set:$current_location to "Doorway")
  (display:"npc screen update location")

  (nl:2)

  You open the door to find (print:$girl's "name") standing there.

  (if:$girl contains "img")[
    (pic:$girl's "img")
