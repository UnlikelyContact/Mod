    (link:"She leaves")[(cs:"invite girl leaves ff")]
    (link:"Ask her to stay the night")[(cs:"invite girl stays ff")]
  </div>
}

:: invite girl leaves ff
{
  (if:$girl contains "img")[
    (pic:$girl's "img")
  ]

  (set:$her_name to $girl's "name")

  $her_name gets dressed, stealing glances at you as she does.

  "(twirl:'Thanks for tonight. That was... special.','Call me again sometime, okay?','I had an amazing time.','We should definitely do this again.')" she says, giving you a soft kiss goodbye.

  <div class='options'>
    (link:"Go to sleep")[
      (display:"advance time")
    ]
  </div>
}

:: invite girl stays ff
{
  (if:$girl contains "img")[
    (pic:$girl's "img")
  ]

  (set:$her_name to $girl's "name")

  "(twirl:'Stay the night?','Want to cuddle?')" you ask.

  (set:$roll to (twist:1,10))
  (if:$roll > 3)[
    She smiles warmly. "(twirl:'I'd love that.','Yes please.','I was hoping you'd ask.')"

    (nl:2)

    She curls up next to you, and you fall asleep in each other's arms.

    (set:$gain_friendship to (twist:1,3))
    (if:$relationships contains $girl_to_load)[
      (set:$npc_select to $girl_to_load)
      (display:"change relationship")
    ]
  ](else:)[
    She looks apologetic. "(twirl:'I wish I could, but I have to get home.','Maybe next time - I have an early morning.','Rain check on the sleepover?')"

    (nl:2)

    She gives you one last kiss and heads out.
  ]

  <div class='options'>
    (link:"Sleep")[
      (display:"advance time")
    ]
  </div>
}
