:: mod invite girl over initialize
{
  (if:$girlfriends is 0)[(set:$girlfriends to (a:))]
}

:: add bar girl as girlfriend [girl_number]
{
  (if:$npc is not 0)[
    (set:$bar_girl_id to (text:$npc's "id"))
    (if:$relationships contains $bar_girl_id)[
      (set:$rel to $relationships's $bar_girl_id)
      (if:$rel contains "tags")[
        (unless:$rel's "tags" contains "girlfriend")[
          (set:$rel's "tags" to it + (a:"girlfriend"))
          (set:$relationships's $bar_girl_id to $rel)
        ]
      ](else:)[
        (set:$relationships's $bar_girl_id to (dm:
          "id",$npc's "id",
          "name",$npc's "name",
          "gender","female",
          "respect",0,
          "dom",0,
          "friendship",(twist:1,4),
          "attraction",(twist:3,6),
          "tags",(a:"girlfriend")
        ))
      ]
    ](else:)[
      (set:$relationships's $bar_girl_id to (dm:
        "id",$npc's "id",
        "name",$npc's "name",
        "gender","female",
        "respect",0,
        "dom",0,
        "friendship",(twist:1,4),
        "attraction",(twist:3,6),
        "tags",(a:"girlfriend")
      ))
    ]
    (display:"npc find girlfriends")
  ]
}

:: npc find girlfriends
{
  (set:$girlfriends to (a:))
  (for: each _key, ...(datanames:$relationships))[
    (set:_rel to _key of $relationships)
    (if:_rel's tags contains "girlfriend")[
      (if:_rel's gender is "female")[
        (set:$girlfriends to it + (a:_rel's id))
      ]
    ]
  ]
}

:: npc request girlfriend relationship
{
  (unless:$sex_outfit is "none")[(set:$girl's "seen outfits" to (a:$sex_outfit))]

  (if:(twist:1,2) is 1)[
    She (twirl:"asks for your number","wants to get your number","wants your number","wants to see you again").
  ](else:)[
    "(twirl:"That was amazing,","Wow, you were incredible,","You were great,","That was so good,")" she says. "(twirl:"Can I get your number?","We should do this again sometime.","I'd love to see you again.","Give me your number?")"
  ]

  <div class='options'>
    (link:"Give her your number")[($cs:"npc request girlfriend accept")]
    (link:(twirl:"Refuse","Turn her down","No","Don't"))[($cs:"npc request girlfriend reject")]
  </div>
}

:: npc request girlfriend accept
{
  (set:$relationships's (text:$girl's "id") to (dm:
    "id",$girl's "id",
    "name",$girl's name,
    "gender","female",
    "respect",0,
    "dom",0,
    "friendship",(twist:1,5),
    "attraction",(twist:3,8),
    "tags",(a:"girlfriend")
  ))
  ($passage_tags:"number_gain_female")
  <div class='options'><mark>She now has your number.</mark></div>
  (set:$girlfriends to (a:))
  (display:"npc find girlfriends")
}

:: npc request girlfriend reject
{
  "(twirl:"I don't think so...","Sorry, but I'm not looking for anything serious...","I appreciate the offer, but no thanks,","I prefer to keep things casual,")" you say.

  She looks (twirl:"a bit disappointed","slightly hurt","understanding").

  "(twirl:"No problem, I get it.","That's okay.","I understand.","No worries.")"
}

:: refresh possible activities girlfriends
{
  (display:"npc find girlfriends")
  (activities:(length of $girlfriends > 0),"Invite girl over","evening")
}

:: refresh possible activities relationships [override]
{
  (set:$fuckbuddies to (findfuckbuddies:))
  (activities:(length of $fuckbuddies > 0),"Invite guy over","evening")
  (display:"refresh possible activities girlfriends")
}

:: Invite girl over
{
