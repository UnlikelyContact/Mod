  (set:$bar_girl_name to $bar_girl's "name")
  (set:$girl to $bar_girl)
  (set:$girl_to_load to (text:$bar_girl's "id"))

  (pic:"scenes/generic/bar/leaving bar.jpg")

  You and $bar_girl_name finish your drinks and leave the bar together.

  (nl:2)

  (twirl:
    "The anticipation builds as you walk to your place.",
    "She holds your hand as you walk, both of you eager.",
    "The night air is cool, but the heat between you is undeniable.",
    "You can barely keep your hands off each other on the way home."
  )

  <div class='options'>
    (link:"Continue...")[($cs:"bar lesbian sex scene")]
  </div>
}

:: bar lesbian sex scene
{
  (set:$bar_girl_name to $girl's "name")
  (set:$current_location to "Your Bedroom")
  (display:"play sex music")
  (set:$ambience to "bedroom")
  (display:"play ambience")

  [(vid:"places/home/bedroom/bedroom 1.mp4")]<image|

  You bring $bar_girl_name to your bedroom.

  (nl:2)

  (set:$entrance_scene to (twist:1,5))
  (if:$entrance_scene is 1)[
    (twirl:
      "The moment the door closes, her lips are on yours.",
      "She pushes you against the wall, kissing you hungrily.",
      "You pull her onto the bed, your bodies tangling together.",
      "Clothes start coming off before you even reach the bed."
    )
  ](else-if:$entrance_scene is 2)[
    The tension that's been building all night finally breaks. She kisses you like she's been waiting her whole life for this moment.

    (nl:2)

    *(twirl:"This feels like a scene from a movie.","You've seen this in films, but living it is something else entirely.","The anticipation makes everything more intense.")*
  ](else-if:$entrance_scene is 3)[
    She looks at you with a hunger in her eyes that makes your heart race.

    "(twirl:"I've been imagining this since I first saw you.","You're even more beautiful up close.","Come here.")" she murmurs, pulling you close.
  ](else-if:$entrance_scene is 4)[
    You both pause for a moment, looking at each other. The air is electric with anticipation.

    (twirl:
      "Then she kisses you, soft at first, then deeper.",
      "She reaches up to touch your face, and you melt into her.",
      "The waiting is over. Your lips meet and everything else fades away."
    )
  ](else:)[
    (twirl:
      "The moment the door closes, her lips are on yours.",
      "She pushes you against the wall, kissing you hungrily.",
      "You pull her onto the bed, your bodies tangling together.",
      "Clothes start coming off before you even reach the bed."
    )
  ]

  (set:$stats's "sex as girl" to it + 1)

  (nl:2)

  (if:$girl contains "traits" and $girl's "traits" contains "slut")[
    "(twirl:"I've wanted this all night.","God, you're so hot.","I'm going to make you feel so good.","I can't wait to taste you.")" she breathes.
  ](else:)[
    "(twirl:"I've been thinking about this since we started talking.","You're beautiful.","I want you so badly.","This feels right.","I feel like I've been waiting for someone like you.")" she whispers.
  ]

  (unless:$relationships contains $girl_to_load)[
    (set:$relationships's (text:$girl's "id") to (dm:
      "id",$girl's "id",
      "name",$girl's name,
      "gender","female",
      "respect",0,
      "dom",0,
      "friendship",(twist:1,3),
      "attraction",(twist:4,7),
      "tags",(a:"girlfriend")
    ))
    (display:"npc find girlfriends")
  ]

  <div class='options'>
    (link:"Continue...")[($cs:"invite girl ff sex scene")]
  </div>
}

:: bar girl offers drink lesbian
{
  (set:$bar_girl to $npc)
  (set:$bar_girl_name to $bar_girl's "name")
  (set:$events to $events + (a:"she bought drink lesbian"))

  (set:$purchase to (twirl:"beer","tequila","wine","fruity cocktail","whisky","fruity cocktail","wine"))

  (set:$alcohol_content to $purchase of (dm:
    "beer",(twist:12,15) / 10,
    "tequila",(twist:18,20) / 10,
    "wine",(twist:12,16) / 10,
    "fruity cocktail",(twist:7,11) / 10,
    "whisky",(twist:16,17) / 10,
    "nothing",0
  ))

  (set:$se to $purchase)(display:"play sound")
  (pic:"places/bar/drinks/" + $purchase + ".jpg")

  (if:$bar_girl contains "traits")[
    (if:$bar_girl's "traits" contains "slut")[
      "(twirl:"Let me buy you a drink, gorgeous.","I want to get you a drink... and maybe more later.","A pretty girl like you shouldn't have to buy her own drinks.")" $bar_girl_name says with a wink, and
    ](else-if:$bar_girl's "traits" contains "bimbo")[
      "(twirl:"Omg, let me get you a drink!","Hehe, I wanna buy you something!","Can I like, get you a drink?")" $bar_girl_name giggles, and
    ](else-if:$bar_girl's "traits" contains "religious")[
      "(twirl:"Can I get you something to drink?","Would you like a drink? My treat.","Let me buy you a drink.")" $bar_girl_name offers politely, and
    ](else-if:$bar_girl's "traits" contains "likes assertive")[
      "(twirl:"I'm getting you a drink.","You're having a drink with me.","I insist on buying you a drink.")" $bar_girl_name says confidently, and
    ](else:)[
      "(twirl:"Can I buy you a drink?","Let me get you something to drink.","Want me to grab you a drink?")" $bar_girl_name offers, and
    ]
  ](else:)[
    "(twirl:"Can I buy you a drink?","Let me get you something to drink.","Want me to grab you a drink?")" $bar_girl_name offers, and
  ]

  (if:$purchase is "beer")[(twirl:"orders you a beer.","gets you a cold beer.","orders you both some beer.")]
  (else-if:$purchase is "tequila")[(twirl:"gets you a shot of tequila.","orders tequila shots for both of you.","gets you some tequila.")]
  (else-if:$purchase is "wine")[(twirl:"gets you a glass of wine.","orders you a nice glass of wine.","gets you both some wine.")]
  (else-if:$purchase is "fruity cocktail")[(twirl:"gets you a colorful cocktail.","orders you a fruity cocktail.","gets you both fancy cocktails.")]
  (else-if:$purchase is "whisky")[(twirl:"gets you a glass of whisky.","orders you some whisky.","gets you both whisky.")]

  *(twirl:"A woman buying you a drink... this feels nice.","It's kind of nice being treated for once.","You could get used to this.","Role reversal, and you're into it.")*

  <div class='options'>
    (link:"Accept the drink")[
      (set:$response to "accept drink")
      ($cs:"bar girl offers drink react lesbian")
    ]
    (if:$character's "arousal" > 5 or $character's "alcohol status" > 1)[
      *(twirl:"It'd be rude to refuse...","She already ordered it...","You'd feel bad saying no.")* (link:"Use Action Point (to reject drink)")[
        (set:$response to "reject drink")
        (set:$action_params to (dm:"cost",1,"result","bar girl offers drink react lesbian","type","replace text"))
        (display:"use action point")
      ]
    ](else:)[
      (link:"Politely decline")[
        (set:$response to "reject drink")
        ($cs:"bar girl offers drink react lesbian")
      ]
    ]
  </div>
}

:: bar girl offers drink react lesbian
{
  (set:$bar_girl to $npc)
  (set:$bar_girl_name to $bar_girl's "name")

  (if:$bar_girl contains "img")[
    (pic:$bar_girl's "img")
  ]

  (if:$response is "accept drink")[
    You accept the drink with a smile.

    (set:$character's "alcohol status" to it + $alcohol_content)

    (nl:2)

    (twirl:
      "You clink glasses and take a sip. It's good.",
      "The drink is exactly what you needed.",
      "You thank her and enjoy the drink together.",
      "The gesture is sweet, and the drink is even better."
    )

    (nl:2)

    (if:$bar_girl contains "traits" and $bar_girl's "traits" contains "slut")[
      "(twirl:"Cheers, beautiful.","To new friends... and maybe more.","I love watching you drink that.")" she says flirtatiously.
    ](else-if:$bar_girl contains "traits" and $bar_girl's "traits" contains "bimbo")[
      "(twirl:"Hehe, cheers!","Omg, isn't this fun?","Yay, drink buddies!")" she giggles.
    ](else:)[
      "(twirl:"Cheers.","To a good night.","I'm glad you accepted.","Here's to meeting new people.")" she says warmly.
    ]

    (set:$gain_attraction to (twist:1,2))
    (set:$gain_friendship to (twist:1,2))
    (set:$npc_select to (text:$bar_girl's "id"))
    (display:"change relationship")
    (dec:'boredom',2)
  ](else:)[
    "(twirl:"Oh, no thank you. I appreciate it though.","That's sweet, but I'm okay.","I shouldn't, but thanks for offering.")" you say.

    (nl:2)

    (if:$bar_girl contains "traits" and $bar_girl's "traits" contains "slut")[
      $bar_girl_name looks slightly disappointed. "(twirl:"Your loss, gorgeous.","Suit yourself.","More for me then.")"
    ](else:)[
      $bar_girl_name nods understandingly. "(twirl:"No worries.","That's fine.","No problem.")"
    ]

    (inc:'boredom',1)
  ]

  <div class='options'>
    (link:"Back")[($cs:"bar chat girl options female")]
  </div>
}
